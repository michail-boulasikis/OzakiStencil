index 3b807ac..ae7297f 100755
--- a/src/1d_half_sparse/CMakeLists.txt
+++ b/src/1d_half_sparse/CMakeLists.txt
@@ -19,8 +19,10 @@ function(cuda_add_executable target)
     set_target_properties(
         ${target}
         PROPERTIES
-        CUDA_SEPARABLE_COMPILATION ON)
+        CUDA_SEPARABLE_COMPILATION ON
+        CUDA_ARCHITECTURES "${GPU_ARCH}"
+      )
     target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-O3 -lineinfo --use_fast_math --ptxas-options=-v -lineinfo>)
 endfunction()
 
